# AIFlow Environment Variables
# Provide the necessary API keys and environment configurations below.

# Application settings
APP_ENV=development
APP_PORT=8000
APP_URL=http://localhost:8000

# API Keys for AI integrations
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Automation & Email integration
N8N_WEBHOOK_URL=your_n8n_webhook_url
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password

# Contact form receiving email
CONTACT_RECEIVER_EMAIL=hello@aiflow.ai
